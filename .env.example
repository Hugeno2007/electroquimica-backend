# Copia este archivo como .env y reemplaza los marcadores con tus valores.
# El archivo .env real contiene credenciales y nunca se sube a GitHub.

# Neon / PostgreSQL
DB_HOST=TU_HOST_DE_NEON
DB_NAME=TU_BASE_DE_DATOS
DB_USER=TU_USUARIO
DB_PASSWORD=TU_CONTRASENA
DB_PORT=5432
DB_SSLMODE=require
DB_CHANNEL_BINDING=require

# Orígenes locales permitidos para el frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
